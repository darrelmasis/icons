{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/server.js" },
    { "source": "/svg/(.*)", "destination": "/api/server.js" },
    { "source": "/png/(.*)", "destination": "/api/server.js" },
    { "source": "/((?!api/|svg/|png/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/server.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}