{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/server.js?path=api/$1" },
    { "source": "/svg/(.*)", "destination": "/api/server.js?path=api/svg/$1" },
    { "source": "/png/(.*)", "destination": "/api/server.js?path=api/png/$1" },
    { "source": "/((?!api/|svg/|png/|assets/|.*\\..*).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/server.js": {
      "memory": 1024,
      "maxDuration": 10,
      "includeFiles": "src/assets/icons/**"
    }
  }
}